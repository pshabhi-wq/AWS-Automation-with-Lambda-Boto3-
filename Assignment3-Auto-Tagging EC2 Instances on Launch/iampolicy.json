{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2TaggingOps",
            "Effect": "Allow",
            "Action": ["ec2:DescribeInstances", "ec2:CreateTags"],
            "Resource": "*"
        },
        {
            "Sid": "Logging",
            "Effect": "Allow",
            "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
            "Resource": "arn:aws:logs:*:*:*"
        }
    ]
}